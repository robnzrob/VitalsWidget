<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Vitals.Widget.MainWindow"
        Title="Vitals.Widget"
        ShowInTaskbar="False"
        Width="130"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="#00000000">
  <Window.Styles>
    <!-- Primary/secondary buttons for the dialog footer -->
    <Style Selector="Button.primary">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <!-- Lock hotspot: clickable but hidden unless hint or hover -->
<Style Selector="Border#LockHotspot">
  <!-- Transparent keeps it hittable even when visually hidden -->
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Cursor" Value="Hand"/>
</Style>

<!-- Default: hide the inner dot -->
<Style Selector="Border#LockHotspot TextBlock">
  <Setter Property="Opacity" Value="0"/>
</Style>

<!-- Timed hint state (shown for ~10s after changes) -->
<Style Selector="Border#LockHotspot.hint">
  <Setter Property="Background" Value="#22FFFFFF"/>
  <Setter Property="BorderBrush" Value="#55FFFFFF"/>
  <Setter Property="BorderThickness" Value="1"/>
</Style>

<Style Selector="Border#LockHotspot.hint TextBlock">
  <Setter Property="Opacity" Value="0.55"/>
</Style>

<!-- Hover always wins: show clearly -->
<Style Selector="Border#LockHotspot:pointerover">
  <Setter Property="Background" Value="#33FFFFFF"/>
  <Setter Property="BorderBrush" Value="#88FFFFFF"/>
  <Setter Property="BorderThickness" Value="1"/>
</Style>

<Style Selector="Border#LockHotspot:pointerover TextBlock">
  <Setter Property="Opacity" Value="1"/>
</Style>


  </Window.Styles>

  <Border x:Name="RootBorder"
          CornerRadius="10"
          Padding="6,4"
          Background="#00000000"
          PointerPressed="Border_OnPointerPressed">

    <Border.ContextMenu>
      <ContextMenu Opened="ContextMenu_OnOpened">

        <MenuItem x:Name="LockMenuItem"
                  Header="Lock position"
                  ToggleType="CheckBox"
                  Click="Lock_OnClick"
                  />

        <Separator/>

        <MenuItem x:Name="ShowCpuMenuItem"
                  Header="Show CPU"
                  ToggleType="CheckBox"

                  Click="ShowCpu_OnClick"/>

        <MenuItem x:Name="ShowGpuMenuItem"
                  Header="Show GPU"
                  ToggleType="CheckBox"
                  Click="ShowGpu_OnClick"/>

        <Separator/>

        <MenuItem Header="Reset position" Click="ResetPosition_OnClick"/>
        <Separator/>
        <MenuItem Header="Settings..." Click="Settings_OnClick"/>

        <Separator/>

        <MenuItem Header="Exit" Click="Exit_OnClick"/>

      </ContextMenu>
    </Border.ContextMenu>

    <Grid>
  <StackPanel Spacing="1" VerticalAlignment="Bottom">

    <TextBlock x:Name="PlaceholderText"
               Text="Vitals"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="Gainsboro"
               IsVisible="False"/>

    <TextBlock x:Name="CpuText"
               Text="CPU ..."
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="Lime"/>

    <TextBlock x:Name="GpuText"
               Text="GPU ..."
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="Lime"/>

  </StackPanel>

  <!-- Tiny hotspot that stays clickable when locked -->
  <Border x:Name="LockHotspot"
          Width="20"
          Height="20"
          CornerRadius="10"          
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          IsVisible="False">
    <TextBlock Text="●"
               FontSize="10"
               Foreground="#CC000000"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
  </Border>
</Grid>


  </Border>
</Window>
